# Provider selection: offline | openai | azure
# "offline" is the default and requires no credentials. It uses a deterministic
# hash embedder and an extractive stub generator, so tests, evals and CI run
# without network access or API keys.
ATOQA_PROVIDER=offline

# --- OpenAI ---
# ATOQA_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# ATOQA_CHAT_MODEL=gpt-4o-mini
# ATOQA_EMBED_MODEL=text-embedding-3-small

# --- Azure OpenAI ---
# ATOQA_PROVIDER=azure
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-06-01
# ATOQA_CHAT_DEPLOYMENT=gpt-4o-mini
# ATOQA_EMBED_DEPLOYMENT=text-embedding-3-small

# Retrieval / abstention tuning
ATOQA_TOP_K=6
ATOQA_MIN_RETRIEVAL_SCORE=0.18
ATOQA_MIN_GROUNDEDNESS=0.60
